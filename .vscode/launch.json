{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug current TS file",
      "runtimeExecutable": "${workspaceFolder}/reconstruct/node_modules/.bin/tsx",
      "args": ["${file}"],
      "cwd": "${fileDirname}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug reconstruct: debug-me.ts",
      "runtimeExecutable": "${workspaceFolder}/reconstruct/node_modules/.bin/tsx",
      "args": ["${workspaceFolder}/reconstruct/debug-me.ts"],
      "cwd": "${workspaceFolder}/reconstruct",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug reconstruct CLI",
      "runtimeExecutable": "${workspaceFolder}/reconstruct/node_modules/.bin/tsx",
      "args": ["src/cli.ts", "请用 echo 工具重复：hello"],
      "cwd": "${workspaceFolder}/reconstruct",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true
    },
    {
      "name": "Debug reconstruct-go server",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/reconstruct-go/cmd/server",
      "cwd": "${workspaceFolder}/reconstruct-go",
      "dlvFlags": ["--check-go-version=false"]
    },
    {
      "name": "Debug reconstruct-go CLI",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/reconstruct-go/cmd/cli",
      "args": ["请用 echo 工具重复：hello"],
      "cwd": "${workspaceFolder}/reconstruct-go",
      "dlvFlags": ["--check-go-version=false"]
    }
  ]
}

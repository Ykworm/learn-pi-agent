{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug current TS file",
      "runtimeExecutable": "${workspaceFolder}/reconstruct/node_modules/.bin/tsx",
      "args": ["${file}"],
      "cwd": "${fileDirname}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug reconstruct: debug-me.ts",
      "runtimeExecutable": "${workspaceFolder}/reconstruct/node_modules/.bin/tsx",
      "args": ["${workspaceFolder}/reconstruct/debug-me.ts"],
      "cwd": "${workspaceFolder}/reconstruct",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug reconstruct CLI",
      "runtimeExecutable": "${workspaceFolder}/reconstruct/node_modules/.bin/tsx",
      "args": ["src/cli.ts"],
      "cwd": "${workspaceFolder}/reconstruct",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true
    }
  ]
}

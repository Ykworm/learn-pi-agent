{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug current TS file",
      "runtimeExecutable": "${workspaceFolder}/reconstruct/node_modules/.bin/tsx",
      "args": ["${file}"],
      "cwd": "${fileDirname}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug reconstruct: debug-me.ts",
      "runtimeExecutable": "${workspaceFolder}/reconstruct/node_modules/.bin/tsx",
      "args": ["${workspaceFolder}/reconstruct/debug-me.ts"],
      "cwd": "${workspaceFolder}/reconstruct",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug reconstruct CLI",
      "runtimeExecutable": "${workspaceFolder}/reconstruct/node_modules/.bin/tsx",
      "args": ["src/cli.ts", "列出当前目录"],
      "cwd": "${workspaceFolder}/reconstruct",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true
    },
    {
      "name": "Debug reconstruct-go server",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "debugAdapter": "dlv-dap",
      "program": "${workspaceFolder}/reconstruct-go/cmd/server",
      "cwd": "${workspaceFolder}/reconstruct-go",
      "console": "integratedTerminal",
      "env": {
        "GOROOT": "/Users/yuweikang/sdk/go1.27.0",
        "GOTOOLCHAIN": "local",
        "PATH": "/Users/yuweikang/sdk/go1.27.0/bin:${env:PATH}"
      }
    },
    {
      "name": "Debug reconstruct-go CLI",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "debugAdapter": "dlv-dap",
      "program": "${workspaceFolder}/reconstruct-go/cmd/cli",
      "args": ["列出当前目录"],
      "cwd": "${workspaceFolder}/reconstruct-go",
      "console": "integratedTerminal",
      "env": {
        "GOROOT": "/Users/yuweikang/sdk/go1.27.0",
        "GOTOOLCHAIN": "local",
        "PATH": "/Users/yuweikang/sdk/go1.27.0/bin:${env:PATH}"
      }
    }
  ]
}
